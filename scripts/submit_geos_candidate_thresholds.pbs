#!/bin/bash -l

#######################################################################
#                     Batch Parameters for Run Job
#######################################################################

#PBS -l walltime=8:00:00
#PBS -l select=1:ncpus=1:mpiprocs=1:model=sky_ele
#PBS -N geos_tc_thresh
#PBS -q normal
#PBS -W group_list=s2406
#PBS -j oe -k oed

# Calculate basin-dependent GEOS candidate wind thresholds by mapping observed
# IBTrACS 34-kt percentiles onto structurally gated GEOS TC-candidate Vmax.

set -u
umask 022

SUBMIT_DIR="${PBS_O_WORKDIR:-$(pwd)}"

if [[ -d "${SUBMIT_DIR}/scripts" ]]; then
  REPO_ROOT="${SUBMIT_DIR}"
elif [[ "$(basename "${SUBMIT_DIR}")" == "scripts" ]]; then
  REPO_ROOT="${SUBMIT_DIR%/scripts}"
else
  SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  REPO_ROOT="${SCRIPT_DIR%/scripts}"
fi

SFC_ROOT="${SFC_ROOT:-/nobackupp27/afahad/project/GEOS-S2S_TC/data}"
ATM_ROOT="${ATM_ROOT:-/nobackupp17/afahad/GEOSS2S3_atm}"
SFC_COLLECTION="${SFC_COLLECTION:-sfc_tavg_3hr_glo_L720x361_sfc}"
ATM_COLLECTION="${ATM_COLLECTION:-atm_inst_6hr_glo_L720x361_p49}"
INIT_DATE="${INIT_DATE:-20200824}"
INIT_DATES_FILE="${INIT_DATES_FILE:-}"
ENS="${ENS:-ens1}"
FORECAST_MONTHS="${FORECAST_MONTHS:-09:10}"
OBSERVED_PERCENTILES="${OBSERVED_PERCENTILES:-${REPO_ROOT}/data/obs/ibtracs/ibtracs_observed_percentiles.csv}"
OBSERVED_WIND_VARS="${OBSERVED_WIND_VARS:-usa_wind}"
OBSERVED_BASIN_METHOD="${OBSERVED_BASIN_METHOD:-boxes}"
OUTPUT_DIR="${OUTPUT_DIR:-${REPO_ROOT}/data/calibration}"
OUTPUT_PREFIX="${OUTPUT_PREFIX:-}"
SFC_MATCH_TOLERANCE_HOURS="${SFC_MATCH_TOLERANCE_HOURS:-3.1}"
ENVIRONMENT_RADIUS_DEG="${ENVIRONMENT_RADIUS_DEG:-5.0}"
INNER_CORE_RADIUS_DEG="${INNER_CORE_RADIUS_DEG:-1.5}"
WIND_SEARCH_RADIUS_DEG="${WIND_SEARCH_RADIUS_DEG:-3.0}"
MAX_CENTERS_PER_BASIN="${MAX_CENTERS_PER_BASIN:-5}"
MIN_CENTER_SEPARATION_DEG="${MIN_CENTER_SEPARATION_DEG:-6.0}"
LOCAL_MIN_RADIUS_DEG="${LOCAL_MIN_RADIUS_DEG:-2.0}"
CENTER_SEARCH_POINTS="${CENTER_SEARCH_POINTS:-200}"
WRITE_ALL_CENTERS="${WRITE_ALL_CENTERS:-0}"
IGNORE_VORTICITY="${IGNORE_VORTICITY:-0}"
MAX_INIT_DATES="${MAX_INIT_DATES:-0}"
OCEAN_ONLY="${OCEAN_ONLY:-1}"
OCEAN_MASK_SOURCE="${OCEAN_MASK_SOURCE:-auto}"
OCEAN_MASK_FILE="${OCEAN_MASK_FILE:-/nobackupp28/knakada/GEOSS2S3/GEOS_fcst/20240829/ens2/sfc_tavg_3hr_glo_L720x361_sfc/20240829.sfc_tavg_3hr_glo_L720x361_sfc.monthly.202408.nc4}"
OCEAN_THRESHOLD="${OCEAN_THRESHOLD:-0.5}"
RESUME="${RESUME:-0}"
PROGRESS_PATH="${PROGRESS_PATH:-}"
AUTO_RESUBMIT="${AUTO_RESUBMIT:-0}"
RESUBMIT_AFTER_HOURS="${RESUBMIT_AFTER_HOURS:-7.5}"
RESUBMIT_COUNT="${RESUBMIT_COUNT:-0}"
MAX_RESUBMITS="${MAX_RESUBMITS:-0}"
AUTO_RESUBMIT_ACTIVE="${AUTO_RESUBMIT}"
if [[ "${AUTO_RESUBMIT}" == "1" && "${MAX_RESUBMITS}" != "0" && "${RESUBMIT_COUNT}" -ge "${MAX_RESUBMITS}" ]]; then
  AUTO_RESUBMIT_ACTIVE="0"
fi
STOP_AFTER_HOURS="${STOP_AFTER_HOURS:-0}"
if [[ "${AUTO_RESUBMIT_ACTIVE}" == "1" && ( "${STOP_AFTER_HOURS}" == "0" || "${STOP_AFTER_HOURS}" == "0.0" ) ]]; then
  STOP_AFTER_HOURS="${RESUBMIT_AFTER_HOURS}"
fi
RUN_CANDIDATE_DIAGNOSTICS="${RUN_CANDIDATE_DIAGNOSTICS:-0}"
CANDIDATE_DIAG_CANDIDATES="${CANDIDATE_DIAG_CANDIDATES:-}"
CANDIDATE_DIAG_THRESHOLDS="${CANDIDATE_DIAG_THRESHOLDS:-}"
CANDIDATE_DIAG_OBSERVED_PERCENTILES="${CANDIDATE_DIAG_OBSERVED_PERCENTILES:-${OBSERVED_PERCENTILES}}"
CANDIDATE_DIAG_OBSERVED_WIND_VAR="${CANDIDATE_DIAG_OBSERVED_WIND_VAR:-${OBSERVED_WIND_VARS%%,*}}"
CANDIDATE_DIAG_OBSERVED_BASIN_METHOD="${CANDIDATE_DIAG_OBSERVED_BASIN_METHOD:-${OBSERVED_BASIN_METHOD}}"
CANDIDATE_DIAG_MONTHS="${CANDIDATE_DIAG_MONTHS:-${FORECAST_MONTHS}}"
CANDIDATE_DIAG_MIN_LAT="${CANDIDATE_DIAG_MIN_LAT:--25}"
CANDIDATE_DIAG_MAX_LAT="${CANDIDATE_DIAG_MAX_LAT:-50}"
CANDIDATE_DIAG_PLOT_DIR="${CANDIDATE_DIAG_PLOT_DIR:-${REPO_ROOT}/plots/geos_candidate_diagnostics}"
CANDIDATE_DIAG_PREFIX="${CANDIDATE_DIAG_PREFIX:-}"
CANDIDATE_DIAG_DPI="${CANDIDATE_DIAG_DPI:-300}"
CANDIDATE_DIAG_DENSITY_BIN_DEG="${CANDIDATE_DIAG_DENSITY_BIN_DEG:-2.0}"
RUN_COUNT_DIAGNOSTICS="${RUN_COUNT_DIAGNOSTICS:-0}"
COUNT_DIAG_CANDIDATES="${COUNT_DIAG_CANDIDATES:-}"
COUNT_DIAG_IBTRACS="${COUNT_DIAG_IBTRACS:-${REPO_ROOT}/data/obs/ibtracs/IBTrACS.since1980.v04r01.nc}"
COUNT_DIAG_START_YEAR="${COUNT_DIAG_START_YEAR:-1991}"
COUNT_DIAG_END_YEAR="${COUNT_DIAG_END_YEAR:-2024}"
COUNT_DIAG_MONTHS="${COUNT_DIAG_MONTHS:-${FORECAST_MONTHS}}"
COUNT_DIAG_WIND_VAR="${COUNT_DIAG_WIND_VAR:-usa_wind}"
COUNT_DIAG_THRESHOLD_KT="${COUNT_DIAG_THRESHOLD_KT:-34}"
COUNT_DIAG_NATURE_FILTER="${COUNT_DIAG_NATURE_FILTER:-TS}"
COUNT_DIAG_OBSERVED_COUNT_METRIC="${COUNT_DIAG_OBSERVED_COUNT_METRIC:-active_time}"
COUNT_DIAG_THRESHOLD_SOURCE="${COUNT_DIAG_THRESHOLD_SOURCE:-recompute}"
COUNT_DIAG_MIN_LAT="${COUNT_DIAG_MIN_LAT:--25}"
COUNT_DIAG_MAX_LAT="${COUNT_DIAG_MAX_LAT:-50}"
COUNT_DIAG_EXPECTED_MEMBERS_PER_YEAR="${COUNT_DIAG_EXPECTED_MEMBERS_PER_YEAR:-0}"
COUNT_DIAG_OUTPUT_DIR="${COUNT_DIAG_OUTPUT_DIR:-${OUTPUT_DIR}/count_comparison}"
COUNT_DIAG_PLOT_DIR="${COUNT_DIAG_PLOT_DIR:-${REPO_ROOT}/plots/geos_ibtracs_count_comparison}"
COUNT_DIAG_PREFIX="${COUNT_DIAG_PREFIX:-}"
CONDA_ENV="${CONDA_ENV:-earth}"
CONDA_BASE="${CONDA_BASE:-}"
PYTHON_BIN="${PYTHON_BIN:-}"

resolve_conda_base() {
  local candidate
  local candidates=()

  if [[ -n "${CONDA_BASE}" && -d "${CONDA_BASE}" ]]; then
    return 0
  fi

  if command -v conda >/dev/null 2>&1; then
    CONDA_BASE="$(conda info --base 2>/dev/null || true)"
    if [[ -n "${CONDA_BASE}" && -d "${CONDA_BASE}" ]]; then
      return 0
    fi
  fi

  candidates=(
    "${HOME:-}/miniconda3"
    "${HOME:-}/miniforge3"
    "${HOME:-}/anaconda3"
    "/nobackupnfs1/afahad/miniconda3"
    "/nobackupnfs1/afahad/miniforge3"
    "/nobackupp27/afahad/miniconda3"
    "/nobackupp27/afahad/miniforge3"
    "/nobackupp27/afahad/anaconda3"
  )

  for candidate in "${candidates[@]}"; do
    if [[ -n "${candidate}" && -d "${candidate}" ]]; then
      CONDA_BASE="${candidate}"
      return 0
    fi
  done

  return 1
}

activate_conda_env() {
  local activate_status

  if [[ -z "${CONDA_ENV}" || "${CONDA_ENV}" == "none" ]]; then
    echo "Skipping conda activation because CONDA_ENV=${CONDA_ENV}"
    return 0
  fi

  if ! resolve_conda_base; then
    echo "ERROR could not find conda base."
    echo "Pass it explicitly, for example:"
    echo "  qsub -v CONDA_BASE=/path/to/miniconda3,CONDA_ENV=${CONDA_ENV} ..."
    return 1
  fi

  if [[ -f "${CONDA_BASE}/etc/profile.d/conda.sh" ]]; then
    set +u
    # shellcheck disable=SC1091
    source "${CONDA_BASE}/etc/profile.d/conda.sh"
    conda activate "${CONDA_ENV}"
    activate_status=$?
    set -u
    return "${activate_status}"
  elif [[ -f "${CONDA_BASE}/bin/activate" ]]; then
    set +u
    # shellcheck disable=SC1091
    source "${CONDA_BASE}/bin/activate" "${CONDA_ENV}"
    activate_status=$?
    set -u
    return "${activate_status}"
  else
    echo "ERROR conda activation scripts not found under CONDA_BASE=${CONDA_BASE}"
    return 1
  fi
}

hours_to_seconds() {
  awk -v hours="$1" 'BEGIN {
    if (hours < 0) {
      hours = 0
    }
    printf "%d", hours * 3600
  }'
}

append_qsub_var() {
  local name="$1"
  local value="$2"
  if [[ -z "${value}" ]]; then
    return 0
  fi
  RESUBMIT_VARS+=("${name}=${value}")
}

submit_resume_job() {
  local next_count
  local qsub_status
  local varlist

  if [[ -z "${PBS_JOBID:-}" ]]; then
    echo "WARNING: PBS_JOBID is not set; cannot queue dependent resume job."
    return 1
  fi
  if [[ -n "${RESUBMIT_QUEUED_FLAG:-}" && -f "${RESUBMIT_QUEUED_FLAG}" ]]; then
    echo "Resume job has already been queued by this job."
    return 0
  fi

  next_count=$((RESUBMIT_COUNT + 1))
  RESUBMIT_VARS=()
  append_qsub_var "SFC_ROOT" "${SFC_ROOT}"
  append_qsub_var "ATM_ROOT" "${ATM_ROOT}"
  append_qsub_var "SFC_COLLECTION" "${SFC_COLLECTION}"
  append_qsub_var "ATM_COLLECTION" "${ATM_COLLECTION}"
  append_qsub_var "INIT_DATE" "${INIT_DATE}"
  append_qsub_var "INIT_DATES_FILE" "${INIT_DATES_FILE}"
  append_qsub_var "ENS" "${ENS}"
  append_qsub_var "FORECAST_MONTHS" "${FORECAST_MONTHS}"
  append_qsub_var "OBSERVED_PERCENTILES" "${OBSERVED_PERCENTILES}"
  append_qsub_var "OBSERVED_WIND_VARS" "${OBSERVED_WIND_VARS}"
  append_qsub_var "OBSERVED_BASIN_METHOD" "${OBSERVED_BASIN_METHOD}"
  append_qsub_var "OUTPUT_DIR" "${OUTPUT_DIR}"
  append_qsub_var "OUTPUT_PREFIX" "${OUTPUT_PREFIX}"
  append_qsub_var "SFC_MATCH_TOLERANCE_HOURS" "${SFC_MATCH_TOLERANCE_HOURS}"
  append_qsub_var "ENVIRONMENT_RADIUS_DEG" "${ENVIRONMENT_RADIUS_DEG}"
  append_qsub_var "INNER_CORE_RADIUS_DEG" "${INNER_CORE_RADIUS_DEG}"
  append_qsub_var "WIND_SEARCH_RADIUS_DEG" "${WIND_SEARCH_RADIUS_DEG}"
  append_qsub_var "MAX_CENTERS_PER_BASIN" "${MAX_CENTERS_PER_BASIN}"
  append_qsub_var "MIN_CENTER_SEPARATION_DEG" "${MIN_CENTER_SEPARATION_DEG}"
  append_qsub_var "LOCAL_MIN_RADIUS_DEG" "${LOCAL_MIN_RADIUS_DEG}"
  append_qsub_var "CENTER_SEARCH_POINTS" "${CENTER_SEARCH_POINTS}"
  append_qsub_var "WRITE_ALL_CENTERS" "${WRITE_ALL_CENTERS}"
  append_qsub_var "IGNORE_VORTICITY" "${IGNORE_VORTICITY}"
  append_qsub_var "MAX_INIT_DATES" "${MAX_INIT_DATES}"
  append_qsub_var "OCEAN_ONLY" "${OCEAN_ONLY}"
  append_qsub_var "OCEAN_MASK_SOURCE" "${OCEAN_MASK_SOURCE}"
  append_qsub_var "OCEAN_MASK_FILE" "${OCEAN_MASK_FILE}"
  append_qsub_var "OCEAN_THRESHOLD" "${OCEAN_THRESHOLD}"
  append_qsub_var "RESUME" "1"
  append_qsub_var "PROGRESS_PATH" "${PROGRESS_PATH}"
  append_qsub_var "AUTO_RESUBMIT" "${AUTO_RESUBMIT}"
  append_qsub_var "RESUBMIT_AFTER_HOURS" "${RESUBMIT_AFTER_HOURS}"
  append_qsub_var "RESUBMIT_COUNT" "${next_count}"
  append_qsub_var "MAX_RESUBMITS" "${MAX_RESUBMITS}"
  append_qsub_var "STOP_AFTER_HOURS" "${STOP_AFTER_HOURS}"
  append_qsub_var "RUN_CANDIDATE_DIAGNOSTICS" "${RUN_CANDIDATE_DIAGNOSTICS}"
  append_qsub_var "CANDIDATE_DIAG_CANDIDATES" "${CANDIDATE_DIAG_CANDIDATES}"
  append_qsub_var "CANDIDATE_DIAG_THRESHOLDS" "${CANDIDATE_DIAG_THRESHOLDS}"
  append_qsub_var "CANDIDATE_DIAG_OBSERVED_PERCENTILES" "${CANDIDATE_DIAG_OBSERVED_PERCENTILES}"
  append_qsub_var "CANDIDATE_DIAG_OBSERVED_WIND_VAR" "${CANDIDATE_DIAG_OBSERVED_WIND_VAR}"
  append_qsub_var "CANDIDATE_DIAG_OBSERVED_BASIN_METHOD" "${CANDIDATE_DIAG_OBSERVED_BASIN_METHOD}"
  append_qsub_var "CANDIDATE_DIAG_MONTHS" "${CANDIDATE_DIAG_MONTHS}"
  append_qsub_var "CANDIDATE_DIAG_MIN_LAT" "${CANDIDATE_DIAG_MIN_LAT}"
  append_qsub_var "CANDIDATE_DIAG_MAX_LAT" "${CANDIDATE_DIAG_MAX_LAT}"
  append_qsub_var "CANDIDATE_DIAG_PLOT_DIR" "${CANDIDATE_DIAG_PLOT_DIR}"
  append_qsub_var "CANDIDATE_DIAG_PREFIX" "${CANDIDATE_DIAG_PREFIX}"
  append_qsub_var "CANDIDATE_DIAG_DPI" "${CANDIDATE_DIAG_DPI}"
  append_qsub_var "CANDIDATE_DIAG_DENSITY_BIN_DEG" "${CANDIDATE_DIAG_DENSITY_BIN_DEG}"
  append_qsub_var "RUN_COUNT_DIAGNOSTICS" "${RUN_COUNT_DIAGNOSTICS}"
  append_qsub_var "COUNT_DIAG_CANDIDATES" "${COUNT_DIAG_CANDIDATES}"
  append_qsub_var "COUNT_DIAG_IBTRACS" "${COUNT_DIAG_IBTRACS}"
  append_qsub_var "COUNT_DIAG_START_YEAR" "${COUNT_DIAG_START_YEAR}"
  append_qsub_var "COUNT_DIAG_END_YEAR" "${COUNT_DIAG_END_YEAR}"
  append_qsub_var "COUNT_DIAG_MONTHS" "${COUNT_DIAG_MONTHS}"
  append_qsub_var "COUNT_DIAG_WIND_VAR" "${COUNT_DIAG_WIND_VAR}"
  append_qsub_var "COUNT_DIAG_THRESHOLD_KT" "${COUNT_DIAG_THRESHOLD_KT}"
  append_qsub_var "COUNT_DIAG_NATURE_FILTER" "${COUNT_DIAG_NATURE_FILTER}"
  append_qsub_var "COUNT_DIAG_OBSERVED_COUNT_METRIC" "${COUNT_DIAG_OBSERVED_COUNT_METRIC}"
  append_qsub_var "COUNT_DIAG_THRESHOLD_SOURCE" "${COUNT_DIAG_THRESHOLD_SOURCE}"
  append_qsub_var "COUNT_DIAG_MIN_LAT" "${COUNT_DIAG_MIN_LAT}"
  append_qsub_var "COUNT_DIAG_MAX_LAT" "${COUNT_DIAG_MAX_LAT}"
  append_qsub_var "COUNT_DIAG_EXPECTED_MEMBERS_PER_YEAR" "${COUNT_DIAG_EXPECTED_MEMBERS_PER_YEAR}"
  append_qsub_var "COUNT_DIAG_OUTPUT_DIR" "${COUNT_DIAG_OUTPUT_DIR}"
  append_qsub_var "COUNT_DIAG_PLOT_DIR" "${COUNT_DIAG_PLOT_DIR}"
  append_qsub_var "COUNT_DIAG_PREFIX" "${COUNT_DIAG_PREFIX}"
  append_qsub_var "CONDA_ENV" "${CONDA_ENV}"
  append_qsub_var "CONDA_BASE" "${CONDA_BASE}"
  append_qsub_var "PYTHON_BIN" "${PYTHON_BIN}"

  varlist="$(IFS=,; echo "${RESUBMIT_VARS[*]}")"
  echo "Submitting resume job after current job exits: qsub -W depend=afterany:${PBS_JOBID} -v ${varlist} ${REPO_ROOT}/scripts/submit_geos_candidate_thresholds.pbs"
  qsub -W "depend=afterany:${PBS_JOBID}" -v "${varlist}" "${REPO_ROOT}/scripts/submit_geos_candidate_thresholds.pbs"
  qsub_status=$?
  if (( qsub_status == 0 )); then
    if [[ -n "${RESUBMIT_QUEUED_FLAG:-}" ]]; then
      touch "${RESUBMIT_QUEUED_FLAG}" 2>/dev/null || true
    fi
  fi
  return "${qsub_status}"
}

start_resubmit_watchdog() {
  local delay_seconds

  if [[ "${AUTO_RESUBMIT_ACTIVE}" != "1" ]]; then
    return 0
  fi
  if [[ -z "${PBS_JOBID:-}" ]]; then
    echo "WARNING: AUTO_RESUBMIT=1 but PBS_JOBID is not set; resume job will not be queued automatically."
    return 0
  fi
  RESUBMIT_DONE_FLAG="${TMPDIR:-/tmp}/geos_tc_thresh_done_${PBS_JOBID}"
  RESUBMIT_QUEUED_FLAG="${TMPDIR:-/tmp}/geos_tc_thresh_resume_queued_${PBS_JOBID}"
  rm -f "${RESUBMIT_DONE_FLAG}"
  rm -f "${RESUBMIT_QUEUED_FLAG}"
  delay_seconds="$(hours_to_seconds "${RESUBMIT_AFTER_HOURS}")"
  (
    sleep "${delay_seconds}"
    if [[ -f "${RESUBMIT_DONE_FLAG}" ]]; then
      exit 0
    fi
    echo "AUTO_RESUBMIT timer passed after ${RESUBMIT_AFTER_HOURS} hours at $(date)."
    submit_resume_job
  ) &
  RESUBMIT_WATCHDOG_PID=$!
  echo "AUTO_RESUBMIT watchdog started: pid=${RESUBMIT_WATCHDOG_PID}, delay_seconds=${delay_seconds}, resume_count=${RESUBMIT_COUNT}"
}

cleanup_resubmit_watchdog() {
  if [[ -n "${RESUBMIT_DONE_FLAG:-}" ]]; then
    touch "${RESUBMIT_DONE_FLAG}" 2>/dev/null || true
  fi
  if [[ -n "${RESUBMIT_WATCHDOG_PID:-}" ]] && kill -0 "${RESUBMIT_WATCHDOG_PID}" 2>/dev/null; then
    kill "${RESUBMIT_WATCHDOG_PID}" 2>/dev/null || true
  fi
}

trap cleanup_resubmit_watchdog EXIT

effective_output_prefix() {
  local first_init=""
  local last_init=""
  local init_label=""
  local ens_label
  local item
  local dates=()

  if [[ -n "${OUTPUT_PREFIX}" ]]; then
    printf "%s" "${OUTPUT_PREFIX}"
    return 0
  fi

  if [[ -n "${INIT_DATES_FILE}" && -f "${INIT_DATES_FILE}" ]]; then
    first_init="$(awk 'NF && $1 !~ /^#/ {print $1; exit}' "${INIT_DATES_FILE}")"
    last_init="$(awk 'NF && $1 !~ /^#/ {value=$1} END {print value}' "${INIT_DATES_FILE}")"
  fi

  if [[ -z "${first_init}" || -z "${last_init}" ]]; then
    for item in ${INIT_DATE//[,:]/ }; do
      if [[ -n "${item}" ]]; then
        dates+=("${item}")
      fi
    done
    if (( ${#dates[@]} > 0 )); then
      first_init="${dates[0]}"
      last_init="${dates[$(( ${#dates[@]} - 1 ))]}"
    fi
  fi

  if [[ -n "${first_init}" && -n "${last_init}" && "${first_init}" != "${last_init}" ]]; then
    init_label="${first_init}_${last_init}"
  else
    init_label="${first_init:-${last_init:-${INIT_DATE}}}"
  fi

  ens_label="${ENS//,/-}"
  printf "geos_candidate_thresholds_%s_%s" "${init_label}" "${ens_label}"
}

run_candidate_diagnostics() {
  local diag_candidates
  local diag_prefix
  local diag_thresholds
  local diag_status
  local diag_cmd
  local effective_prefix

  if [[ "${RUN_CANDIDATE_DIAGNOSTICS}" != "1" ]]; then
    return 0
  fi
  effective_prefix="$(effective_output_prefix)"

  diag_candidates="${CANDIDATE_DIAG_CANDIDATES}"
  if [[ -z "${diag_candidates}" ]]; then
    diag_candidates="${OUTPUT_DIR}/${effective_prefix}_candidates.csv"
  fi

  diag_thresholds="${CANDIDATE_DIAG_THRESHOLDS}"
  if [[ -z "${diag_thresholds}" ]]; then
    diag_thresholds="${OUTPUT_DIR}/${effective_prefix}.csv"
  fi

  diag_prefix="${CANDIDATE_DIAG_PREFIX}"
  if [[ -z "${diag_prefix}" ]]; then
    diag_prefix="${effective_prefix}"
  fi

  diag_cmd=(
    "${PYTHON_BIN}" -u scripts/plot_geos_candidate_diagnostics.py
    --candidates "${diag_candidates}"
    --observed-percentiles "${CANDIDATE_DIAG_OBSERVED_PERCENTILES}"
    --observed-wind-var "${CANDIDATE_DIAG_OBSERVED_WIND_VAR}"
    --observed-basin-method "${CANDIDATE_DIAG_OBSERVED_BASIN_METHOD}"
    --months "${CANDIDATE_DIAG_MONTHS}"
    --min-lat "${CANDIDATE_DIAG_MIN_LAT}"
    --max-lat "${CANDIDATE_DIAG_MAX_LAT}"
    --ocean-mask-source "${OCEAN_MASK_SOURCE}"
    --ocean-mask-file "${OCEAN_MASK_FILE}"
    --ocean-threshold "${OCEAN_THRESHOLD}"
    --plot-dir "${CANDIDATE_DIAG_PLOT_DIR}"
    --prefix "${diag_prefix}"
    --dpi "${CANDIDATE_DIAG_DPI}"
    --density-bin-deg "${CANDIDATE_DIAG_DENSITY_BIN_DEG}"
  )

  if [[ -n "${diag_thresholds}" ]]; then
    diag_cmd+=(--thresholds "${diag_thresholds}")
  fi
  if [[ "${OCEAN_ONLY}" != "1" ]]; then
    diag_cmd+=(--no-ocean-only)
  fi

  echo "Running candidate diagnostics: ${diag_cmd[*]}"
  "${diag_cmd[@]}"
  diag_status=$?
  if (( diag_status != 0 )); then
    echo "WARNING: candidate diagnostics failed with status ${diag_status}; threshold/resume workflow will continue."
  fi
  return 0
}

run_count_diagnostics() {
  local diag_candidates
  local diag_prefix
  local diag_status
  local diag_cmd
  local effective_prefix

  if [[ "${RUN_COUNT_DIAGNOSTICS}" != "1" ]]; then
    return 0
  fi
  effective_prefix="$(effective_output_prefix)"

  diag_candidates="${COUNT_DIAG_CANDIDATES}"
  if [[ -z "${diag_candidates}" ]]; then
    diag_candidates="${OUTPUT_DIR}/${effective_prefix}_candidates.csv"
  fi

  diag_prefix="${COUNT_DIAG_PREFIX}"
  if [[ -z "${diag_prefix}" ]]; then
    diag_prefix="geos_ibtracs_count_comparison_${effective_prefix}"
  fi

  diag_cmd=(
    "${PYTHON_BIN}" -u scripts/compare_geos_candidates_to_ibtracs_counts.py
    --candidates "${diag_candidates}"
    --ibtracs "${COUNT_DIAG_IBTRACS}"
    --start-year "${COUNT_DIAG_START_YEAR}"
    --end-year "${COUNT_DIAG_END_YEAR}"
    --months "${COUNT_DIAG_MONTHS}"
    --wind-var "${COUNT_DIAG_WIND_VAR}"
    --threshold-kt "${COUNT_DIAG_THRESHOLD_KT}"
    --observed-count-metric "${COUNT_DIAG_OBSERVED_COUNT_METRIC}"
    --threshold-source "${COUNT_DIAG_THRESHOLD_SOURCE}"
    --min-lat "${COUNT_DIAG_MIN_LAT}"
    --max-lat "${COUNT_DIAG_MAX_LAT}"
    --ocean-mask-source "${OCEAN_MASK_SOURCE}"
    --ocean-mask-file "${OCEAN_MASK_FILE}"
    --ocean-threshold "${OCEAN_THRESHOLD}"
    --output-dir "${COUNT_DIAG_OUTPUT_DIR}"
    --plot-dir "${COUNT_DIAG_PLOT_DIR}"
    --prefix "${diag_prefix}"
  )

  if [[ -n "${COUNT_DIAG_NATURE_FILTER}" && "${COUNT_DIAG_NATURE_FILTER}" != "all" ]]; then
    diag_cmd+=(--nature-filter "${COUNT_DIAG_NATURE_FILTER}")
  else
    diag_cmd+=(--all-natures)
  fi

  if [[ "${COUNT_DIAG_EXPECTED_MEMBERS_PER_YEAR}" != "0" ]]; then
    diag_cmd+=(--expected-members-per-year "${COUNT_DIAG_EXPECTED_MEMBERS_PER_YEAR}")
  fi
  if [[ "${OCEAN_ONLY}" != "1" ]]; then
    diag_cmd+=(--no-ocean-only)
  fi

  echo "Running count diagnostics: ${diag_cmd[*]}"
  "${diag_cmd[@]}"
  diag_status=$?
  if (( diag_status != 0 )); then
    echo "WARNING: count diagnostics failed with status ${diag_status}; threshold/resume workflow will continue."
  fi
  return 0
}

echo "Job started: $(date)"
echo "REPO_ROOT=${REPO_ROOT}"
echo "SFC_ROOT=${SFC_ROOT}"
echo "ATM_ROOT=${ATM_ROOT}"
echo "SFC_COLLECTION=${SFC_COLLECTION}"
echo "ATM_COLLECTION=${ATM_COLLECTION}"
echo "INIT_DATE=${INIT_DATE}"
echo "INIT_DATES_FILE=${INIT_DATES_FILE}"
echo "ENS=${ENS}"
echo "FORECAST_MONTHS=${FORECAST_MONTHS}"
echo "OBSERVED_PERCENTILES=${OBSERVED_PERCENTILES}"
echo "OBSERVED_WIND_VARS=${OBSERVED_WIND_VARS}"
echo "OBSERVED_BASIN_METHOD=${OBSERVED_BASIN_METHOD}"
echo "OUTPUT_DIR=${OUTPUT_DIR}"
echo "OUTPUT_PREFIX=${OUTPUT_PREFIX}"
echo "MAX_CENTERS_PER_BASIN=${MAX_CENTERS_PER_BASIN}"
echo "MIN_CENTER_SEPARATION_DEG=${MIN_CENTER_SEPARATION_DEG}"
echo "LOCAL_MIN_RADIUS_DEG=${LOCAL_MIN_RADIUS_DEG}"
echo "CENTER_SEARCH_POINTS=${CENTER_SEARCH_POINTS}"
echo "WRITE_ALL_CENTERS=${WRITE_ALL_CENTERS}"
echo "IGNORE_VORTICITY=${IGNORE_VORTICITY}"
echo "OCEAN_ONLY=${OCEAN_ONLY}"
echo "OCEAN_MASK_SOURCE=${OCEAN_MASK_SOURCE}"
echo "OCEAN_MASK_FILE=${OCEAN_MASK_FILE}"
echo "OCEAN_THRESHOLD=${OCEAN_THRESHOLD}"
echo "RESUME=${RESUME}"
echo "PROGRESS_PATH=${PROGRESS_PATH}"
echo "AUTO_RESUBMIT=${AUTO_RESUBMIT}"
echo "AUTO_RESUBMIT_ACTIVE=${AUTO_RESUBMIT_ACTIVE}"
echo "RESUBMIT_AFTER_HOURS=${RESUBMIT_AFTER_HOURS}"
echo "RESUBMIT_COUNT=${RESUBMIT_COUNT}"
echo "MAX_RESUBMITS=${MAX_RESUBMITS}"
echo "STOP_AFTER_HOURS=${STOP_AFTER_HOURS}"
echo "RUN_CANDIDATE_DIAGNOSTICS=${RUN_CANDIDATE_DIAGNOSTICS}"
echo "CANDIDATE_DIAG_CANDIDATES=${CANDIDATE_DIAG_CANDIDATES}"
echo "CANDIDATE_DIAG_THRESHOLDS=${CANDIDATE_DIAG_THRESHOLDS}"
echo "CANDIDATE_DIAG_OBSERVED_PERCENTILES=${CANDIDATE_DIAG_OBSERVED_PERCENTILES}"
echo "CANDIDATE_DIAG_OBSERVED_WIND_VAR=${CANDIDATE_DIAG_OBSERVED_WIND_VAR}"
echo "CANDIDATE_DIAG_OBSERVED_BASIN_METHOD=${CANDIDATE_DIAG_OBSERVED_BASIN_METHOD}"
echo "CANDIDATE_DIAG_MONTHS=${CANDIDATE_DIAG_MONTHS}"
echo "CANDIDATE_DIAG_MIN_LAT=${CANDIDATE_DIAG_MIN_LAT}"
echo "CANDIDATE_DIAG_MAX_LAT=${CANDIDATE_DIAG_MAX_LAT}"
echo "CANDIDATE_DIAG_PLOT_DIR=${CANDIDATE_DIAG_PLOT_DIR}"
echo "CANDIDATE_DIAG_PREFIX=${CANDIDATE_DIAG_PREFIX}"
echo "CANDIDATE_DIAG_DPI=${CANDIDATE_DIAG_DPI}"
echo "CANDIDATE_DIAG_DENSITY_BIN_DEG=${CANDIDATE_DIAG_DENSITY_BIN_DEG}"
echo "RUN_COUNT_DIAGNOSTICS=${RUN_COUNT_DIAGNOSTICS}"
echo "COUNT_DIAG_CANDIDATES=${COUNT_DIAG_CANDIDATES}"
echo "COUNT_DIAG_IBTRACS=${COUNT_DIAG_IBTRACS}"
echo "COUNT_DIAG_START_YEAR=${COUNT_DIAG_START_YEAR}"
echo "COUNT_DIAG_END_YEAR=${COUNT_DIAG_END_YEAR}"
echo "COUNT_DIAG_MONTHS=${COUNT_DIAG_MONTHS}"
echo "COUNT_DIAG_WIND_VAR=${COUNT_DIAG_WIND_VAR}"
echo "COUNT_DIAG_THRESHOLD_KT=${COUNT_DIAG_THRESHOLD_KT}"
echo "COUNT_DIAG_NATURE_FILTER=${COUNT_DIAG_NATURE_FILTER}"
echo "COUNT_DIAG_OBSERVED_COUNT_METRIC=${COUNT_DIAG_OBSERVED_COUNT_METRIC}"
echo "COUNT_DIAG_THRESHOLD_SOURCE=${COUNT_DIAG_THRESHOLD_SOURCE}"
echo "COUNT_DIAG_MIN_LAT=${COUNT_DIAG_MIN_LAT}"
echo "COUNT_DIAG_MAX_LAT=${COUNT_DIAG_MAX_LAT}"
echo "COUNT_DIAG_EXPECTED_MEMBERS_PER_YEAR=${COUNT_DIAG_EXPECTED_MEMBERS_PER_YEAR}"
echo "COUNT_DIAG_OUTPUT_DIR=${COUNT_DIAG_OUTPUT_DIR}"
echo "COUNT_DIAG_PLOT_DIR=${COUNT_DIAG_PLOT_DIR}"
echo "COUNT_DIAG_PREFIX=${COUNT_DIAG_PREFIX}"
echo "CONDA_ENV=${CONDA_ENV}"
echo "CONDA_BASE=${CONDA_BASE:-auto}"

cd "${REPO_ROOT}"
mkdir -p "${OUTPUT_DIR}"
export MPLCONFIGDIR="${TMPDIR:-/tmp}/matplotlib-${PBS_JOBID:-geos_tc_thresh}"
export PYTHONUNBUFFERED=1
mkdir -p "${MPLCONFIGDIR}"

if ! activate_conda_env; then
  exit 6
fi

if [[ -z "${PYTHON_BIN}" ]]; then
  PYTHON_BIN="$(command -v python 2>/dev/null || command -v python3 2>/dev/null || true)"
fi

if [[ -z "${PYTHON_BIN}" ]]; then
  echo "ERROR python was not found after conda activation."
  exit 7
fi

echo "ACTIVE_CONDA_PREFIX=${CONDA_PREFIX:-}"
echo "PYTHON_BIN=${PYTHON_BIN}"
echo "PYTHONUNBUFFERED=${PYTHONUNBUFFERED}"
"${PYTHON_BIN}" -u - <<'PY'
import netCDF4
import numpy
print("Python dependency check passed: netCDF4 and numpy are available")
PY
dep_status=$?
if (( dep_status != 0 )); then
  echo "ERROR Python dependency check failed in CONDA_ENV=${CONDA_ENV}"
  exit 8
fi

start_resubmit_watchdog

cmd=(
  "${PYTHON_BIN}" -u scripts/calculate_geos_candidate_thresholds.py
  --sfc-root "${SFC_ROOT}"
  --atm-root "${ATM_ROOT}"
  --sfc-collection "${SFC_COLLECTION}"
  --atm-collection "${ATM_COLLECTION}"
  --ens "${ENS}"
  --months "${FORECAST_MONTHS}"
  --observed-percentiles "${OBSERVED_PERCENTILES}"
  --observed-wind-vars "${OBSERVED_WIND_VARS}"
  --observed-basin-method "${OBSERVED_BASIN_METHOD}"
  --output-dir "${OUTPUT_DIR}"
  --sfc-match-tolerance-hours "${SFC_MATCH_TOLERANCE_HOURS}"
  --environment-radius-deg "${ENVIRONMENT_RADIUS_DEG}"
  --inner-core-radius-deg "${INNER_CORE_RADIUS_DEG}"
  --wind-search-radius-deg "${WIND_SEARCH_RADIUS_DEG}"
  --max-centers-per-basin "${MAX_CENTERS_PER_BASIN}"
  --min-center-separation-deg "${MIN_CENTER_SEPARATION_DEG}"
  --local-min-radius-deg "${LOCAL_MIN_RADIUS_DEG}"
  --center-search-points "${CENTER_SEARCH_POINTS}"
)

if [[ "${WRITE_ALL_CENTERS}" == "1" ]]; then
  cmd+=(--write-all-centers)
fi

if [[ -n "${INIT_DATES_FILE}" ]]; then
  cmd+=(--init-dates-file "${INIT_DATES_FILE}")
else
  cmd+=(--init-date "${INIT_DATE}")
fi

if [[ -n "${OUTPUT_PREFIX}" ]]; then
  cmd+=(--output-prefix "${OUTPUT_PREFIX}")
fi

if [[ "${IGNORE_VORTICITY}" == "1" ]]; then
  cmd+=(--ignore-vorticity)
fi

if [[ "${MAX_INIT_DATES}" != "0" ]]; then
  cmd+=(--max-init-dates "${MAX_INIT_DATES}")
fi

cmd+=(--ocean-mask-source "${OCEAN_MASK_SOURCE}" --ocean-mask-file "${OCEAN_MASK_FILE}" --ocean-threshold "${OCEAN_THRESHOLD}")
if [[ "${OCEAN_ONLY}" != "1" ]]; then
  cmd+=(--no-ocean-only)
fi

if [[ "${RESUME}" == "1" ]]; then
  cmd+=(--resume)
fi

if [[ -n "${PROGRESS_PATH}" ]]; then
  cmd+=(--progress-path "${PROGRESS_PATH}")
fi

if [[ "${STOP_AFTER_HOURS}" != "0" && "${STOP_AFTER_HOURS}" != "0.0" ]]; then
  cmd+=(--stop-after-hours "${STOP_AFTER_HOURS}")
fi

echo "Running: ${cmd[*]}"
"${cmd[@]}"
status=$?

if [[ "${status}" == "0" || "${status}" == "75" ]]; then
  run_candidate_diagnostics
  run_count_diagnostics
fi

if [[ "${AUTO_RESUBMIT_ACTIVE}" == "1" && "${status}" == "75" ]]; then
  echo "Python stopped cleanly after STOP_AFTER_HOURS=${STOP_AFTER_HOURS}; queueing resume job."
  if submit_resume_job; then
    status=0
  fi
fi

echo "Job finished: $(date)"
echo "Exit status: ${status}"
exit "${status}"

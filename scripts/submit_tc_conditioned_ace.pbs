#!/bin/bash -l

#######################################################################
#                     Batch Parameters for Run Job
#######################################################################

#PBS -l walltime=8:00:00
#PBS -l select=1:ncpus=1:mpiprocs=1:model=sky_ele
#PBS -N geos_tc_ace
#PBS -q normal
#PBS -W group_list=s2406
#PBS -j oe -k oed

# Calculate TC-conditioned ACE for one initialization date. The Python driver
# writes one NetCDF cache per init/member, one init-date ensmean cache, and a
# compact member summary CSV for later plotting.

set -u
umask 022

SUBMIT_DIR="${PBS_O_WORKDIR:-$(pwd)}"

if [[ -d "${SUBMIT_DIR}/scripts" ]]; then
  REPO_ROOT="${SUBMIT_DIR}"
elif [[ "$(basename "${SUBMIT_DIR}")" == "scripts" ]]; then
  REPO_ROOT="${SUBMIT_DIR%/scripts}"
else
  SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  REPO_ROOT="${SCRIPT_DIR%/scripts}"
fi

SFC_ROOT="${SFC_ROOT:-/nobackupp27/afahad/project/GEOS-S2S_TC/data}"
ATM_ROOT="${ATM_ROOT:-/nobackupp17/afahad/GEOSS2S3_atm}"
SFC_COLLECTION="${SFC_COLLECTION:-sfc_tavg_3hr_glo_L720x361_sfc}"
ATM_COLLECTION="${ATM_COLLECTION:-atm_inst_6hr_glo_L720x361_p49}"
INIT_DATE="${INIT_DATE:-}"
ENS="${ENS:-all}"
FORECAST_MONTHS="${FORECAST_MONTHS:-09:10}"
CACHE_DIR="${CACHE_DIR:-${REPO_ROOT}/data/cache}"
PLOT_DIR="${PLOT_DIR:-${REPO_ROOT}/plots/ace}"
GEOS_THRESHOLDS="${GEOS_THRESHOLDS:-${REPO_ROOT}/data/calibration/count_comparison/geos_ibtracs_count_comparison_19910824_20240829_all_countmatch_count_calibration.csv}"
THRESHOLD_COLUMN="${THRESHOLD_COLUMN:-count_match_threshold_kt}"
THRESHOLD_WIND_VAR="${THRESHOLD_WIND_VAR:-usa_wind}"
THRESHOLD_BASIN_METHOD="${THRESHOLD_BASIN_METHOD:-boxes}"
SFC_MATCH_TOLERANCE_HOURS="${SFC_MATCH_TOLERANCE_HOURS:-3.1}"
ENVIRONMENT_RADIUS_DEG="${ENVIRONMENT_RADIUS_DEG:-5.0}"
INNER_CORE_RADIUS_DEG="${INNER_CORE_RADIUS_DEG:-1.5}"
WIND_SEARCH_RADIUS_DEG="${WIND_SEARCH_RADIUS_DEG:-3.0}"
FORCE_RECOMPUTE="${FORCE_RECOMPUTE:-0}"
CONDA_ENV="${CONDA_ENV:-earth}"
CONDA_BASE="${CONDA_BASE:-}"
PYTHON_BIN="${PYTHON_BIN:-}"
AUTO_RESUBMIT="${AUTO_RESUBMIT:-1}"
RESUBMIT_AFTER_HOURS="${RESUBMIT_AFTER_HOURS:-7.5}"
RESUBMIT_COUNT="${RESUBMIT_COUNT:-0}"
MAX_RESUBMITS="${MAX_RESUBMITS:-20}"
AUTO_RESUBMIT_ACTIVE="${AUTO_RESUBMIT}"
if [[ "${AUTO_RESUBMIT}" == "1" && "${MAX_RESUBMITS}" != "0" && "${RESUBMIT_COUNT}" -ge "${MAX_RESUBMITS}" ]]; then
  AUTO_RESUBMIT_ACTIVE="0"
fi
STOP_AFTER_HOURS="${STOP_AFTER_HOURS:-0}"
if [[ "${AUTO_RESUBMIT_ACTIVE}" == "1" && ( "${STOP_AFTER_HOURS}" == "0" || "${STOP_AFTER_HOURS}" == "0.0" ) ]]; then
  STOP_AFTER_HOURS="${RESUBMIT_AFTER_HOURS}"
fi

resolve_conda_base() {
  local candidate
  local candidates=()

  if [[ -n "${CONDA_BASE}" && -d "${CONDA_BASE}" ]]; then
    return 0
  fi

  if command -v conda >/dev/null 2>&1; then
    CONDA_BASE="$(conda info --base 2>/dev/null || true)"
    if [[ -n "${CONDA_BASE}" && -d "${CONDA_BASE}" ]]; then
      return 0
    fi
  fi

  candidates=(
    "${HOME:-}/miniconda3"
    "${HOME:-}/miniforge3"
    "${HOME:-}/anaconda3"
    "/nobackupnfs1/afahad/miniconda3"
    "/nobackupnfs1/afahad/miniforge3"
    "/nobackupp27/afahad/miniconda3"
    "/nobackupp27/afahad/miniforge3"
    "/nobackupp27/afahad/anaconda3"
  )

  for candidate in "${candidates[@]}"; do
    if [[ -n "${candidate}" && -d "${candidate}" ]]; then
      CONDA_BASE="${candidate}"
      return 0
    fi
  done

  return 1
}

activate_conda_env() {
  local activate_status

  if [[ -z "${CONDA_ENV}" || "${CONDA_ENV}" == "none" ]]; then
    echo "Skipping conda activation because CONDA_ENV=${CONDA_ENV}"
    return 0
  fi

  if ! resolve_conda_base; then
    echo "ERROR could not find conda base."
    echo "Pass it explicitly, for example:"
    echo "  qsub -v INIT_DATE=19910824,CONDA_BASE=/path/to/miniconda3,CONDA_ENV=${CONDA_ENV} scripts/submit_tc_conditioned_ace.pbs"
    return 1
  fi

  if [[ -f "${CONDA_BASE}/etc/profile.d/conda.sh" ]]; then
    set +u
    # shellcheck disable=SC1091
    source "${CONDA_BASE}/etc/profile.d/conda.sh"
    conda activate "${CONDA_ENV}"
    activate_status=$?
    set -u
    return "${activate_status}"
  elif [[ -f "${CONDA_BASE}/bin/activate" ]]; then
    set +u
    # shellcheck disable=SC1091
    source "${CONDA_BASE}/bin/activate" "${CONDA_ENV}"
    activate_status=$?
    set -u
    return "${activate_status}"
  else
    echo "ERROR conda activation scripts not found under CONDA_BASE=${CONDA_BASE}"
    return 1
  fi
}

hours_to_seconds() {
  awk -v hours="$1" 'BEGIN {
    if (hours < 0) {
      hours = 0
    }
    printf "%d", hours * 3600
  }'
}

append_qsub_var() {
  local name="$1"
  local value="$2"
  if [[ -z "${value}" ]]; then
    return 0
  fi
  RESUBMIT_VARS+=("${name}=${value}")
}

submit_resume_job() {
  local next_count
  local qsub_status
  local varlist

  if [[ -z "${PBS_JOBID:-}" ]]; then
    echo "WARNING: PBS_JOBID is not set; cannot queue dependent resume job."
    return 1
  fi
  if [[ -n "${RESUBMIT_QUEUED_FLAG:-}" && -f "${RESUBMIT_QUEUED_FLAG}" ]]; then
    echo "Resume job has already been queued by this job."
    return 0
  fi

  next_count=$((RESUBMIT_COUNT + 1))
  RESUBMIT_VARS=()
  append_qsub_var "SFC_ROOT" "${SFC_ROOT}"
  append_qsub_var "ATM_ROOT" "${ATM_ROOT}"
  append_qsub_var "SFC_COLLECTION" "${SFC_COLLECTION}"
  append_qsub_var "ATM_COLLECTION" "${ATM_COLLECTION}"
  append_qsub_var "INIT_DATE" "${INIT_DATE}"
  append_qsub_var "ENS" "${ENS}"
  append_qsub_var "FORECAST_MONTHS" "${FORECAST_MONTHS}"
  append_qsub_var "CACHE_DIR" "${CACHE_DIR}"
  append_qsub_var "PLOT_DIR" "${PLOT_DIR}"
  append_qsub_var "GEOS_THRESHOLDS" "${GEOS_THRESHOLDS}"
  append_qsub_var "THRESHOLD_COLUMN" "${THRESHOLD_COLUMN}"
  append_qsub_var "THRESHOLD_WIND_VAR" "${THRESHOLD_WIND_VAR}"
  append_qsub_var "THRESHOLD_BASIN_METHOD" "${THRESHOLD_BASIN_METHOD}"
  append_qsub_var "SFC_MATCH_TOLERANCE_HOURS" "${SFC_MATCH_TOLERANCE_HOURS}"
  append_qsub_var "ENVIRONMENT_RADIUS_DEG" "${ENVIRONMENT_RADIUS_DEG}"
  append_qsub_var "INNER_CORE_RADIUS_DEG" "${INNER_CORE_RADIUS_DEG}"
  append_qsub_var "WIND_SEARCH_RADIUS_DEG" "${WIND_SEARCH_RADIUS_DEG}"
  append_qsub_var "FORCE_RECOMPUTE" "0"
  append_qsub_var "CONDA_ENV" "${CONDA_ENV}"
  append_qsub_var "CONDA_BASE" "${CONDA_BASE}"
  append_qsub_var "PYTHON_BIN" "${PYTHON_BIN}"
  append_qsub_var "AUTO_RESUBMIT" "${AUTO_RESUBMIT}"
  append_qsub_var "RESUBMIT_AFTER_HOURS" "${RESUBMIT_AFTER_HOURS}"
  append_qsub_var "STOP_AFTER_HOURS" "${STOP_AFTER_HOURS}"
  append_qsub_var "RESUBMIT_COUNT" "${next_count}"
  append_qsub_var "MAX_RESUBMITS" "${MAX_RESUBMITS}"
  varlist="$(IFS=,; echo "${RESUBMIT_VARS[*]}")"

  echo "Submitting ACE resume job after current job exits: qsub -W depend=afterany:${PBS_JOBID} -v ${varlist} ${REPO_ROOT}/scripts/submit_tc_conditioned_ace.pbs"
  qsub -W "depend=afterany:${PBS_JOBID}" -v "${varlist}" "${REPO_ROOT}/scripts/submit_tc_conditioned_ace.pbs"
  qsub_status=$?
  if (( qsub_status == 0 )); then
    if [[ -n "${RESUBMIT_QUEUED_FLAG:-}" ]]; then
      touch "${RESUBMIT_QUEUED_FLAG}" 2>/dev/null || true
    fi
  else
    echo "WARNING: failed to submit ACE resume job; qsub status=${qsub_status}"
  fi
  return "${qsub_status}"
}

start_resubmit_watchdog() {
  local delay_seconds

  if [[ "${AUTO_RESUBMIT_ACTIVE}" != "1" ]]; then
    echo "AUTO_RESUBMIT disabled: AUTO_RESUBMIT=${AUTO_RESUBMIT}, RESUBMIT_COUNT=${RESUBMIT_COUNT}, MAX_RESUBMITS=${MAX_RESUBMITS}"
    return 0
  fi
  if [[ -z "${PBS_JOBID:-}" ]]; then
    echo "AUTO_RESUBMIT requested, but PBS_JOBID is not set; watchdog disabled."
    return 0
  fi
  RESUBMIT_DONE_FLAG="${TMPDIR:-/tmp}/geos_tc_ace_done_${PBS_JOBID}"
  RESUBMIT_QUEUED_FLAG="${TMPDIR:-/tmp}/geos_tc_ace_resume_queued_${PBS_JOBID}"
  rm -f "${RESUBMIT_DONE_FLAG}"
  rm -f "${RESUBMIT_QUEUED_FLAG}"
  delay_seconds="$(hours_to_seconds "${RESUBMIT_AFTER_HOURS}")"
  (
    sleep "${delay_seconds}"
    if [[ -f "${RESUBMIT_DONE_FLAG}" ]]; then
      exit 0
    fi
    echo "AUTO_RESUBMIT timer passed after ${RESUBMIT_AFTER_HOURS} hours at $(date)."
    submit_resume_job
  ) &
  RESUBMIT_WATCHDOG_PID=$!
  echo "AUTO_RESUBMIT watchdog started: pid=${RESUBMIT_WATCHDOG_PID}, delay_seconds=${delay_seconds}, resume_count=${RESUBMIT_COUNT}"
}

cleanup_resubmit_watchdog() {
  if [[ -n "${RESUBMIT_DONE_FLAG:-}" ]]; then
    touch "${RESUBMIT_DONE_FLAG}" 2>/dev/null || true
  fi
  if [[ -n "${RESUBMIT_WATCHDOG_PID:-}" ]] && kill -0 "${RESUBMIT_WATCHDOG_PID}" 2>/dev/null; then
    kill "${RESUBMIT_WATCHDOG_PID}" 2>/dev/null || true
  fi
}

trap cleanup_resubmit_watchdog EXIT

cd "${REPO_ROOT}"

if [[ -z "${INIT_DATE}" ]]; then
  echo "ERROR INIT_DATE is required, e.g. qsub -v INIT_DATE=19910824 scripts/submit_tc_conditioned_ace.pbs"
  exit 2
fi

echo "Job started: $(date)"
echo "REPO_ROOT=${REPO_ROOT}"
echo "SFC_ROOT=${SFC_ROOT}"
echo "ATM_ROOT=${ATM_ROOT}"
echo "SFC_COLLECTION=${SFC_COLLECTION}"
echo "ATM_COLLECTION=${ATM_COLLECTION}"
echo "INIT_DATE=${INIT_DATE}"
echo "ENS=${ENS}"
echo "FORECAST_MONTHS=${FORECAST_MONTHS}"
echo "GEOS_THRESHOLDS=${GEOS_THRESHOLDS}"
echo "THRESHOLD_COLUMN=${THRESHOLD_COLUMN}"
echo "CACHE_DIR=${CACHE_DIR}"
echo "PLOT_DIR=${PLOT_DIR}"
echo "FORCE_RECOMPUTE=${FORCE_RECOMPUTE}"
echo "AUTO_RESUBMIT=${AUTO_RESUBMIT}"
echo "AUTO_RESUBMIT_ACTIVE=${AUTO_RESUBMIT_ACTIVE}"
echo "RESUBMIT_AFTER_HOURS=${RESUBMIT_AFTER_HOURS}"
echo "RESUBMIT_COUNT=${RESUBMIT_COUNT}"
echo "MAX_RESUBMITS=${MAX_RESUBMITS}"
echo "STOP_AFTER_HOURS=${STOP_AFTER_HOURS}"
echo "CONDA_ENV=${CONDA_ENV}"
echo "CONDA_BASE=${CONDA_BASE:-auto}"
echo "PYTHON_BIN=${PYTHON_BIN:-auto}"

if ! activate_conda_env; then
  exit 5
fi

if [[ -z "${PYTHON_BIN}" ]]; then
  PYTHON_BIN="$(command -v python || true)"
fi
if [[ -z "${PYTHON_BIN}" ]]; then
  echo "ERROR python executable was not found after activating CONDA_ENV=${CONDA_ENV}"
  exit 6
fi

echo "ACTIVE_CONDA_PREFIX=${CONDA_PREFIX:-}"
echo "PYTHON_BIN=${PYTHON_BIN}"

"${PYTHON_BIN}" - <<'PY'
import importlib.util
missing = [name for name in ("netCDF4", "numpy", "matplotlib") if importlib.util.find_spec(name) is None]
if missing:
    raise SystemExit(f"missing Python package(s): {', '.join(missing)}")
print("Python dependency check passed: netCDF4, numpy, and matplotlib are available")
PY
dep_status=$?
if (( dep_status != 0 )); then
  echo "ERROR Python dependency check failed in CONDA_ENV=${CONDA_ENV}"
  exit 8
fi

start_resubmit_watchdog

cmd=(
  "${PYTHON_BIN}" -u scripts/calculate_tc_conditioned_ace.py
  --sfc-root "${SFC_ROOT}"
  --atm-root "${ATM_ROOT}"
  --sfc-collection "${SFC_COLLECTION}"
  --atm-collection "${ATM_COLLECTION}"
  --init-date "${INIT_DATE}"
  --ens "${ENS}"
  --months "${FORECAST_MONTHS}"
  --cache-dir "${CACHE_DIR}"
  --plot-dir "${PLOT_DIR}"
  --geos-thresholds "${GEOS_THRESHOLDS}"
  --threshold-column "${THRESHOLD_COLUMN}"
  --threshold-wind-var "${THRESHOLD_WIND_VAR}"
  --threshold-basin-method "${THRESHOLD_BASIN_METHOD}"
  --sfc-match-tolerance-hours "${SFC_MATCH_TOLERANCE_HOURS}"
  --environment-radius-deg "${ENVIRONMENT_RADIUS_DEG}"
  --inner-core-radius-deg "${INNER_CORE_RADIUS_DEG}"
  --wind-search-radius-deg "${WIND_SEARCH_RADIUS_DEG}"
  --stop-after-hours "${STOP_AFTER_HOURS}"
)

if [[ "${FORCE_RECOMPUTE}" == "1" ]]; then
  cmd+=(--force-recompute)
fi

echo "Running: ${cmd[*]}"
"${cmd[@]}"
status=$?

echo "Job finished: $(date)"
echo "Exit status: ${status}"
echo "ACE cache files for INIT_DATE=${INIT_DATE}:"
find "${CACHE_DIR}" -maxdepth 1 \( -name "tc_conditioned_ace_${INIT_DATE}_*.nc4" -o -name "tc_conditioned_ace_${INIT_DATE}_member_summary.csv" \) -print | sort

exit "${status}"
